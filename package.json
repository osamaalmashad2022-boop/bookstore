{
  "name": "arabic-bookstore-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Perpetual Zero-Cost Mobile-First Physical Arabic Bookstore & Smart Book Recommender",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "start": "npm --prefix server run start"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}

