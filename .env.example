# ========================================================
# Perpetual Zero-Cost Arabic Bookstore Configuration (.env)
# 100% Free Forever Tiers (Zero Paid Renewals / Zero Cards)
# ========================================================

# Server Port
PORT=5000

# Database Configuration:
# - For Local SQLite (Default, 100% zero-config): leave blank or set file path
# - For Turso Serverless SQLite (Free Forever: 5GB storage + 500M row reads/month):
#   DATABASE_URL=libsql://[your-db-name]-[org].turso.io
#   DATABASE_AUTH_TOKEN=[your-turso-token]
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Merchant WhatsApp Order Receiving Number (International format without +)
# e.g. 201012345678 for Egypt
MERCHANT_PHONE=201012345678

# Store Settings
STORE_NAME="مقبرة الكتب المنسية"
FREE_SHIPPING_THRESHOLD=600
BUNDLE_DISCOUNT_PERCENT=10

# Admin Secret Key / Password for Protected Store Management Dashboard
# Default in development: maqbara2026
ADMIN_PASSWORD=maqbara2026

# Optional: Google Gemini API Key for Polish Layer (Free Tier)
# If omitted or deprecated, the local hybrid deterministic engine continues running seamlessly!
GEMINI_API_KEY=

# Optional: Google Books API Key (Free Forever - 1,000 queries/day)
# Provides dedicated, unthrottled Google Books queries for 1-Click Auto-Fill.
# If omitted, searches automatically use shared Google quota and fall back to Open Library!
GOOGLE_BOOKS_API_KEY=

