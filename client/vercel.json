{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/follow/(.*)",
      "destination": "/follow/$1"
    },
    {
      "source": "/follow",
      "destination": "/follow/index.html"
    },
    {
      "source": "/((?!assets/|follow/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

